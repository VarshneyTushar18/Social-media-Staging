APP_NAME=Stackposts
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_INSTALLED=false
APP_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stackposts
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=stackposts_installer_session
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Website Builder — published sites (see modules/AppWebsiteBuilder/config/config.php)
# Wildcard subdomain host, e.g. sites.yourproduct.com (empty = path URLs at APP_URL/sites/{slug})
WEBSITE_PUBLISH_DOMAIN=
WEBSITE_PUBLISH_PATH_PREFIX=sites
# Public IPv4 customers point apex @ A record to (required for custom-domain DNS verify on live)
WEBSITE_PUBLISH_A_RECORD=

# GoDaddy domain search / checkout (use production + live keys on live; ote for OTE)
GODADDY_API_ENV=ote
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_API_TOKEN=

# Namecheap (set sandbox=false on live; client_ip must be your server public egress IP)
NAMECHEAP_SANDBOX=true
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=



